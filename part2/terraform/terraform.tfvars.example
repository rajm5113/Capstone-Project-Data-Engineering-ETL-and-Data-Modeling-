# Optional overrides for a custom lab deployment.
# For the standard Coursera lab, do NOT copy this file to terraform.tfvars:
# source part2/scripts/setup.sh discovers and exports the required TF_VAR_* values.
# If changing these defaults, set the same TF_VAR_project / TF_VAR_region
# before sourcing the setup script so discovery and Terraform use the same environment.
project = "de-c4w4a2"
region  = "us-east-1"
